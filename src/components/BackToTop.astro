<button
  id="back-to-top"
  aria-label="Back to top"
  title="Back to top"
  class="fixed bottom-6 right-6 z-[60] size-11 items-center justify-center bg-white border-[3px] border-black text-xl font-bold shadow-[3px_3px_0_#000] transition-all duration-200 hover:-translate-y-1 opacity-0 translate-y-2 pointer-events-none flex"
>
  ↑
</button>

<script>
  const btn = document.getElementById("back-to-top");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  let ticking = false;

  function toggle() {
    ticking = false;
    if (!btn) return;
    const show = window.scrollY > 600;
    btn.classList.toggle("opacity-0", !show);
    btn.classList.toggle("translate-y-2", !show);
    btn.classList.toggle("pointer-events-none", !show);
  }

  function onScroll() {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(toggle);
    }
  }

  toggle();
  window.addEventListener("scroll", onScroll, { passive: true });

  btn?.addEventListener("click", () => {
    window.scrollTo({ top: 0, behavior: reduceMotion ? "auto" : "smooth" });
  });
</script>
