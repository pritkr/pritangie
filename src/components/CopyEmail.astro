---
interface Props {
  email?: string;
  variant?: "yellow" | "blue" | "outline" | "icon";
  label?: string;
}

const {
  email = "pritform@gmail.com",
  variant = "yellow",
  label = "Copy email",
} = Astro.props;

// `outline` mirrors Button.astro's pill geometry exactly (h-12 px-6 border-3
// rounded-full) and differs only in fill, so a copy button placed beside a
// primary CTA reads as its secondary rather than a mismatched twin.
const styles =
  variant === "icon"
    ? "size-10 inline-flex items-center justify-center bg-white border-2 border-black shadow-[2px_2px_0_#000] hover:-translate-y-0.5 transition-[translate,box-shadow] duration-150 active:translate-y-0.5 active:shadow-[1px_1px_0_#000]"
    : variant === "outline"
      ? "h-12 inline-flex items-center gap-2 px-6 rounded-full bg-white border-3 border-black text-black font-medium shadow-[3px_3px_0_#000] hover:-translate-y-0.5 transition-[translate,box-shadow] duration-150 active:translate-y-0.5 active:shadow-[1px_1px_0_#000]"
      : variant === "blue"
        ? "inline-flex items-center gap-2 px-6 py-3 bg-[#BEE7FF] border-2 border-black text-black font-bold hover:-translate-y-0.5 transition-[translate,box-shadow] duration-150 active:translate-y-0.5 active:shadow-[1px_1px_0_#000] shadow-[3px_3px_0_#000]"
        : "inline-flex items-center gap-2 px-6 py-3 bg-[var(--yellow)] border-2 border-black text-black font-bold hover:-translate-y-0.5 transition-[translate,box-shadow] duration-150 active:translate-y-0.5 active:shadow-[1px_1px_0_#000] shadow-[3px_3px_0_#000]";
---

<button
  type="button"
  data-copy-email={email}
  class={styles}
  aria-live="polite"
  title={`Copy ${email} to clipboard`}
>
  <i class="ri-file-copy-line text-lg" aria-hidden="true"></i>
  <span
    data-copy-label
    class={variant === "icon" ? "" : "inline-block min-w-[11ch] text-left"}
  >
    {variant === "icon" ? "" : label}
  </span>
</button>

<script>
  function attachCopyButtons() {
    document.querySelectorAll("[data-copy-email]").forEach((btn) => {
      if ((btn as HTMLElement).dataset.bound === "true") return;
      (btn as HTMLElement).dataset.bound = "true";

      btn.addEventListener("click", async () => {
        const email = (btn as HTMLElement).dataset.copyEmail ?? "";
        const labelEl = btn.querySelector("[data-copy-label]");
        const original = labelEl?.textContent ?? "";
        const isIconOnly = (btn as HTMLElement).dataset.copyEmail !== undefined && !labelEl?.textContent;

        // plans/016 — the label hard-swapped in one frame, and because
        // "Copied!" / "Copy failed" are shorter than the label the bordered
        // button resized twice. min-w-[11ch] reserves the width; swapLabel
        // animates the change so it reads as a state change, not a teleport.
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const swapLabel = (text: string) => {
          if (!labelEl) return;
          labelEl.textContent = text;
          if (!reduceMotion && labelEl.animate) {
            labelEl.animate(
              [
                { opacity: 0, transform: "translateY(6px)" },
                { opacity: 1, transform: "translateY(0)" },
              ],
              { duration: 160, easing: "cubic-bezier(0.23, 1, 0.32, 1)" },
            );
          }
        };

        async function copy(text: string): Promise<boolean> {
          try {
            await navigator.clipboard.writeText(text);
            return true;
          } catch {
            // Fallback for non-secure contexts / older browsers
            try {
              const ta = document.createElement("textarea");
              ta.value = text;
              ta.setAttribute("readonly", "");
              ta.style.position = "fixed";
              ta.style.opacity = "0";
              document.body.appendChild(ta);
              ta.select();
              const ok = document.execCommand("copy");
              document.body.removeChild(ta);
              return ok;
            } catch {
              return false;
            }
          }
        }

        const ok = await copy(email);
        if (labelEl && !isIconOnly) {
          swapLabel(ok ? "Copied!" : "Copy failed");
          setTimeout(() => swapLabel(original), 2000);
        } else {
          // Icon-only buttons: brief visual confirmation via title + scale
          (btn as HTMLElement).style.transform = "translateY(-2px)";
          (btn as HTMLElement).setAttribute("title", ok ? "Copied!" : "Copy failed");
          setTimeout(() => {
            (btn as HTMLElement).style.transform = "";
            (btn as HTMLElement).setAttribute("title", `Copy ${email} to clipboard`);
          }, 1500);
        }
      });
    });
  }

  attachCopyButtons();
  // Re-attach after Astro view transitions
  document.addEventListener("astro:after-swap", attachCopyButtons);
</script>
