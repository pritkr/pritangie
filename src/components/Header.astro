---
import logoStar from "../assets/logo-star.svg";
import svgPinkStar from "../assets/pink-star.svg";
import { author } from "../sample";

const links = [
    { name: "Home", path: "/", target: "_self" },
    { name: "Blog", path: "/blog/", target: "_self" },
    { name: "Projects", path: "/projects", target: "_self" },
    { name: "Résumé", path: "/resume.pdf", target: "_blank" },
    { name: "About", path: "/about", target: "_self" },
    { name: "Elsewhere", path: "/elsewhere", target: "_self" },
    { name: "Contact", path: "mailto:pritform@gmail.com", target: "_self" },
];

const { pathname } = Astro.url;
const current = pathname.replace(/\/+$/, "") || "/";
// Only the PDF opens a new tab; internal and mailto: links must not.
const rel = (target: string) => (target === "_blank" ? "noopener noreferrer" : undefined);
---

<header class="relative border-b-3 p-7 overflow-hidden" style="view-transition-name: site-header">
    <img
        src={svgPinkStar.src}
        alt=""
        width="80"
        class="absolute -right-9 -top-4"
    />
    <img
        src={svgPinkStar.src}
        alt=""
        width="80"
        class="absolute -left-8 -bottom-5 hidden md:block"
    />

    <div
        class="flex border-3 border-black bg-white max-w-[310px] md:max-w-2xl m-auto relative z-10"
    >
        <!-- top boxes -->
        <div
            class="size-2 bg-white border-2 border-black absolute -top-2 -right-2"
        >
        </div>
        <div
            class="size-2 bg-white border-2 border-black absolute -top-2 -left-2"
        >
        </div>

        <!-- bottom boxes -->
        <div
            class="size-2 bg-white border-2 border-black absolute -bottom-2 -left-2"
        >
        </div>
        <div
            class="size-2 bg-white border-2 border-black absolute -bottom-2 -right-2"
        >
        </div>

        <nav class="flex w-full items-center p-2 md:p-0">
            <div class="flex-1 font-bold">
                <a href="/" class="flex items-center gap-2 pl-3">
                    <img src={logoStar.src} alt="logo" width="26" />
                    {author.nickname}
                </a>
            </div>
            <div class="flex items-center gap-2 md:hidden">
                <button
                    type="button"
                    data-command-open
                    class="inline-flex items-center gap-1.5 border-2 border-black bg-[var(--yellow)] px-2 py-1 font-mono text-xs font-bold transition-transform duration-150 active:scale-[0.97]"
                    aria-label="Open PritOS command menu"
                    title="Open PritOS command menu"
                >
                    <i class="ri-terminal-box-line text-lg" aria-hidden="true"></i>
                    <span>PritOS</span>
                </button>
                <a href="#" class="flex" id="menu-open" aria-label="Open menu">
                    <i class="ri-menu-2-line text-2xl"></i>
                </a>
            </div>
            <ul class="hidden md:flex">
                {
                    links.map((item) => (
                        <li class="border-l-2 border-black px-2 py-4 md:px-2.5">
                            <a
                                href={item.path}
                                target={item.target}
                                rel={rel(item.target)}
                                class="whitespace-nowrap relative flex items-center before:absolute before:left-0 before:bottom-1 before:h-[8px] before:w-full before:origin-left before:scale-x-0 before:bg-[var(--yellow)] before:transition-transform before:duration-300 hover:before:scale-x-100"
                            >
                                <span class="relative z-5">
                                    {item.name}{" "}
                                    {current == (item.path.replace(/\/+$/, "") || "/") ? "//" : ""}
                                </span>
                            </a>
                        </li>
                    ))
                }
            </ul>
        </nav>
    </div>
</header>

<div
    class="block md:hidden fixed left-0 top-0 h-full w-full bg-white z-20 p-3 transition-transform duration-300 ease-drawer -translate-x-[100%] invisible"
    id="menu-content"
>
    <div class="flex p-6">
        <p class="flex-1 font-bold uppercase">Menu</p>
        <a href="#" id="menu-close" aria-label="Close menu">
            <i class="ri-close-line text-3xl"></i>
        </a>
    </div>
    <ul class="flex flex-col justify-center items-center gap-4 md:hidden">
        {
            links.map((item) => (
                <li class="py-3">
                    <a
                        href={item.path}
                        target={item.target}
                        rel={rel(item.target)}
                        class="p-3 whitespace-nowrap text-2xl font-bold"
                    >
                        {item.name} {current == (item.path.replace(/\/+$/, "") || "/") ? "//" : ""}
                    </a>
                </li>
            ))
        }
    </ul>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const menuContent = document.querySelector("#menu-content");
        const menuOpen = document.querySelector("#menu-open");
        const menuClose = document.querySelector("#menu-close");

        // `invisible` keeps the closed drawer's links out of the tab order.
        // It must not be part of the transform transition (that would leave
        // visibility stuck at `hidden` while opening), so on close we wait
        // for the slide-out to finish before applying it.
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        const setOpen = (open: boolean) => {
            if (!menuContent) return;
            if (open) {
                menuContent.classList.remove("invisible");
                menuContent.classList.remove("-translate-x-[100%]");
                return;
            }
            menuContent.classList.add("-translate-x-[100%]");
            const hide = () => {
                menuContent.classList.add("invisible");
                menuContent.removeEventListener("transitionend", hide);
            };
            if (reduceMotion) hide();
            else menuContent.addEventListener("transitionend", hide);
        };

        menuOpen?.addEventListener("click", (e) => {
            e.preventDefault();
            setOpen(true);
        });

        menuClose?.addEventListener("click", (e) => {
            e.preventDefault();
            setOpen(false);
        });

        menuContent?.querySelectorAll("li a").forEach((item) => {
            item.addEventListener("click", () => setOpen(false));
        });

        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape" && !menuContent?.classList.contains("invisible")) {
                setOpen(false);
                (menuOpen as HTMLElement | null)?.focus();
            }
        });
    });
</script>
