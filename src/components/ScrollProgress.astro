---
// ScrollProgress: fixed top reading-progress bar, brutalist style.
// Zero deps, rAF-throttled, respects prefers-reduced-motion (still updates, no smooth anim).
---
<div
  id="scroll-progress"
  aria-hidden="true"
  class="fixed top-0 left-0 z-[60] h-1 w-0 bg-[var(--yellow)] border-b-2 border-r-2 border-black"
/>

<script>
  const bar = document.getElementById("scroll-progress");
  let ticking = false;

  function update() {
    ticking = false;
    if (!bar) return;
    const doc = document.documentElement;
    const max = doc.scrollHeight - doc.clientHeight;
    const progress = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
    bar.style.width = `${progress * 100}%`;
  }

  function onScroll() {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(update);
    }
  }

  update();
  window.addEventListener("scroll", onScroll, { passive: true });
  window.addEventListener("resize", onScroll);
</script>
