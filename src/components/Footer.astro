---
import logoStar from '../assets/logo-star.svg'
import { author } from '../sample'

const socials = [
  { icon: 'ri-github-fill', link: author.github, label: 'GitHub' },
  { icon: 'ri-linkedin-box-fill', link: author.linkedin, label: 'LinkedIn' },
  // mailto: must not open a blank tab — it hands off to the mail client
  { icon: 'ri-mail-line', link: author.email, label: 'Email', blank: false },
  { icon: 'ri-instagram-line', link: author.ig, label: 'Instagram' },
  { icon: 'ri-telegram-line', link: author.telegram, label: 'Telegram' },
  { icon: 'ri-chat-3-line', link: author.matrix, label: 'Matrix' },
]

const year = new Date().getFullYear()
---

<footer class="border-t-4 px-5 pt-10 pb-8 mt-12">
    <div class="max-w-4xl mx-auto">
      <div class="flex flex-col items-center gap-6 sm:flex-row sm:justify-between">
        <a href="/" class="flex items-center gap-2.5 text-xl font-bold">
          <img src={logoStar.src} alt="" width="28" /> {author.nickname}
        </a>

        <div class="flex items-center gap-5 text-black">
          {socials.map(item => (
            <a
              href={item.link}
              target={item.blank === false ? undefined : "_blank"}
              rel={item.blank === false ? undefined : "noopener noreferrer"}
              aria-label={item.label}
              class="text-2xl transition-transform duration-200 hover:translate-y-[2px]"
            >
              <i class={item.icon}></i>
            </a>
          ))}
        </div>
      </div>

      <p class="mt-7 text-center text-xs">
        <a
          href="/elsewhere"
          class="font-bold underline decoration-2 underline-offset-2 transition-colors duration-150 hover:bg-[var(--yellow)]"
        >
          Elsewhere
        </a>
        · © {year} · Built with Astro · No trackers · No cookies · Hosted on my own terms
      </p>
    </div>
</footer>
