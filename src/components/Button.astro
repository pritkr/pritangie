---
const { text, link, target } = Astro.props

import svgHl from '../assets/hl.svg'
---

<div class="relative group">
   <a href={link} target={target} class="bg-[var(--blue)] text-black text-base font-medium flex items-center h-12 px-6 border-3 rounded-full transition-transform duration-150 active:scale-[0.97]">{text}</a>
   <img src={svgHl.src} alt="" width="30" class="absolute -right-7 -bottom-3 transition-transform duration-200 group-hover:-translate-y-1" />
</div>
