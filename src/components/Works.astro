---
import Bars from "./Bars.astro";

import svgUnderline from "../assets/underline.svg";
import arrowCard from "../assets/arrow-card.svg";

// Ordered oldest -> newest. No project carries a date, so the order is
// inferred: Predirect is the flagship (270+ stars, longest-running, and the
// project the site is built around), BEU Connect an established standalone
// portal; the four carrying case studies are the most recent body of work;
// listbrew and chaind are current - chaind is in the hero's "building" chip.
// This one array drives both the homepage rail and /projects.
const portfolio = [
  {
    name: "Predirect",
    desc: `One install kills the tracking — 30+ tracked sites (YouTube, X, Reddit, Google…) rewritten to privacy-friendly frontends.`,
    role: "Solo developer",
    outcome: "Chrome, Firefox, Edge",
    repo: "pritkr/predirect",
    fallbackStars: 270,
    cover: "/assets/predirectpreview.avif",
    link: "https://github.com/pritkr/predirect",
    externalLabel: "Repository",
    caseStudy: "/projects/predirect",
    meta: "Manifest V3 · JavaScript",
  },
  {
    name: "BEU Connect",
    desc: `No more treasure hunts across official portals — syllabus, results & notices for every BEU college in one static page that works on any phone.`,
    role: "Solo developer",
    outcome: "Zero-backend static portal",
    cover: "/assets/beuconnect-preview.png",
    link: "https://beu.prit.eu.org",
    externalLabel: "Live demo",
    meta: "HTML · CSS · JS",
  },
  {
    name: "spec-forge",
    desc: `Autonomous agentic code verification and AST-preserving mutation testing engine. Hunts regressions in LLM-generated code by synthesizing invariant tests.`,
    role: "Creator",
    outcome: "AST Mutator & Test Synthesis",
    repo: "pritkr/spec-forge",
    fallbackStars: 49,
    cover: "/assets/predirectpreview.avif",
    link: "https://github.com/pritkr/spec-forge",
    externalLabel: "Repository",
    caseStudy: "/projects/spec-forge",
    meta: "Python · AST · Agentic AI",
  },
  {
    name: "pebble-sync",
    desc: `Ultra-compact, zero-dependency offline-first CRDT sync engine with Merkle clocks & cryptographic audit trails for edge and rural PWAs.`,
    role: "Creator",
    outcome: "Delta Merkle Sync · Zero-Dep",
    repo: "pritkr/pebble-sync",
    fallbackStars: 58,
    cover: "/assets/beuconnect-preview.png",
    link: "https://github.com/pritkr/pebble-sync",
    externalLabel: "Repository",
    caseStudy: "/projects/pebble-sync",
    meta: "TypeScript · Distributed Systems",
  },
  {
    name: "dhvani-eval",
    desc: `Telephony-grade streaming audio evaluation and acoustic degradation harness for Indic voice AI (Hindi, Maithili, Bhojpuri, code-mixed Hinglish).`,
    role: "Creator",
    outcome: "8kHz Telephony Sim & Indic WER",
    repo: "pritkr/dhvani-eval",
    fallbackStars: 35,
    cover: "/assets/beuconnect-preview.png",
    link: "https://github.com/pritkr/dhvani-eval",
    externalLabel: "Repository",
    caseStudy: "/projects/dhvani-eval",
    meta: "Python · Voice AI · Indic Speech",
  },
  {
    name: "sentinel-mcp",
    desc: `Zero-overhead capability-gated security reverse proxy and taint guard for the Model Context Protocol (MCP) in Go. Sandboxes tool calls, stops SSRF & credential leakage.`,
    role: "Creator & Maintainer",
    outcome: "Go · <0.18ms latency · MCP Guard",
    repo: "pritkr/sentinel-mcp",
    fallbackStars: 42,
    cover: "/assets/predirectpreview.avif",
    link: "https://github.com/pritkr/sentinel-mcp",
    externalLabel: "Repository",
    caseStudy: "/projects/sentinel-mcp",
    meta: "Go · AI Security · MCP",
  },
  {
    name: "listbrew",
    desc: `Newsletters that send themselves — realtime auto-sync from Frappe to Listmonk, built for the Bodhya community (FOSS United · Samagata).`,
    role: "Developer",
    outcome: "Auto-sync for Bodhya newsletters",
    repo: "pritkr/listbrew",
    cover: "https://raw.githubusercontent.com/pritkr/listbrew/develop/ss1.webp",
    link: "https://github.com/pritkr/listbrew",
    externalLabel: "Repository",
    meta: "Python · Frappe",
  },
  {
    name: "chaind",
    desc: `Your messages never leave your machine — a daemon that bridges Telegram, Matrix & WhatsApp to local AI agents over a permission-gated Unix socket.`,
    role: "Co-built with fossism",
    outcome: "AGPL-3.0 · bridges 3 messengers",
    repo: "fossism/chaind-cli",
    cover: "https://img.youtube.com/vi/zMO8yXD-v0Q/maxresdefault.jpg",
    link: "https://github.com/fossism/chaind-cli",
    externalLabel: "Repository",
    meta: "Go",
  },
];

// "My Works" is the page <h1> on /projects but a section <h2> on the homepage.
const { headingLevel: Heading = "h2" } = Astro.props;
---

<section class="py-16 sm:py-20 px-5" id="work">
  <div class="max-w-4xl mx-auto">
    <div class="mb-8 flex items-end justify-between gap-6">
      <Heading class="relative inline-block text-4xl font-medium">
        My Works
        <img
          src={svgUnderline.src}
          alt=""
          width="140"
          class="absolute left-1/2 -translate-x-1/2 -bottom-1"
        />
      </Heading>

      <div class="hidden md:flex gap-3">
        <button
          id="rail-prev"
          type="button"
          aria-label="Previous projects"
          class="size-11 flex items-center justify-center bg-white border-3 border-black text-xl font-bold shadow-[3px_3px_0_#000] transition-[translate,scale,box-shadow] duration-150 enabled:hover:-translate-y-0.5 active:scale-[0.95] active:shadow-[1px_1px_0_#000] disabled:opacity-40 disabled:shadow-none disabled:cursor-not-allowed"
        >
          ←
        </button>
        <button
          id="rail-next"
          type="button"
          aria-label="Next projects"
          class="size-11 flex items-center justify-center bg-white border-3 border-black text-xl font-bold shadow-[3px_3px_0_#000] transition-[translate,scale,box-shadow] duration-150 enabled:hover:-translate-y-0.5 active:scale-[0.95] active:shadow-[1px_1px_0_#000] disabled:opacity-40 disabled:shadow-none disabled:cursor-not-allowed"
        >
          →
        </button>
      </div>
    </div>

    <div class="relative">
      <div
        class="works-rail flex gap-6 overflow-x-auto snap-x snap-mandatory py-4"
        tabindex="0"
        role="group"
        aria-label="Project carousel, scrollable"
      >
      {
        portfolio.map((item) => (
          <article
            data-reveal
            class="group w-[300px] sm:w-[340px] shrink-0 snap-start flex flex-col bg-white border-2 border-black p-5 relative transition-shadow duration-200 hover:shadow-[4px_4px_0px_rgba(0,0,0,0.3)]"
          >
            <div class="h-[160px] overflow-hidden bg-[#eef0f2] border-2">
              <img
                src={item.cover}
                alt={`${item.name} screenshot`}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
            </div>
            <div class="flex flex-col gap-1 pt-4 flex-1">
              <div class="flex pr-2">
                <h2 class="text-xl font-medium flex-1">{item.name}</h2>
                <img src={arrowCard.src} alt="" width="25" />
              </div>
              <p class="text-sm">{item.desc}</p>
              {item.role && (
                <p class="text-sm">
                  <span class="font-semibold">{item.role}</span> · {item.outcome}
                </p>
              )}
              {(item as { repo?: string; fallbackStars?: number }).repo && (
                <p class="mt-1 inline-flex w-fit items-center gap-2 border-2 border-black bg-[#fefff0] px-2 py-0.5 text-xs font-bold">
                  <span class="relative flex size-2">
                    <span class="relative inline-flex size-2 rounded-full bg-green-600"></span>
                  </span>
                  <span
                    data-gh-stars={(item as { repo: string }).repo}
                    data-fallback={
                      (item as { fallbackStars?: number }).fallbackStars
                        ? `★ ${(item as { fallbackStars: number }).fallbackStars}`
                        : "★ —"
                    }
                  >
                    {(item as { fallbackStars?: number }).fallbackStars
                      ? `★ ${(item as { fallbackStars: number }).fallbackStars} on GitHub`
                      : "★ live on GitHub"}
                  </span>
                </p>
              )}
              {item.meta && (
                <span class="self-start mt-1 px-3 py-1 text-xs font-semibold bg-[var(--yellow)] border-2 border-black">
                  {item.meta}
                </span>
              )}
              <div class="flex flex-wrap gap-x-5 gap-y-1 pt-2 text-sm font-semibold">
                {item.caseStudy && (
                  <a
                    href={item.caseStudy}
                    class="underline decoration-2 underline-offset-2 hover:bg-[var(--yellow)] px-0.5 transition-colors"
                  >
                    Case study →
                  </a>
                )}
                <a
                  href={item.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="underline decoration-2 underline-offset-2 hover:bg-[var(--yellow)] px-0.5 transition-colors"
                >
                  {item.externalLabel} ↗
                </a>
              </div>
            </div>
            <Bars />
          </article>
        ))
      }
      </div>

      <!-- edge fades: signal that the rail scrolls. Shown only on the side
           that actually has more cards (toggled by the script below). -->
      <div
        class="pointer-events-none absolute inset-y-0 left-0 w-14 bg-gradient-to-r from-[var(--main-bg)] to-transparent opacity-0 transition-opacity duration-200 data-[active]:opacity-100"
        data-rail-fade="start"
        aria-hidden="true"
      >
      </div>
      <div
        class="pointer-events-none absolute inset-y-0 right-0 w-14 bg-gradient-to-l from-[var(--main-bg)] to-transparent opacity-0 transition-opacity duration-200 data-[active]:opacity-100"
        data-rail-fade="end"
        aria-hidden="true"
      >
      </div>
    </div>
  </div>
</section>

<style>
  .works-rail {
    scrollbar-width: none;
  }
  .works-rail::-webkit-scrollbar {
    display: none;
  }
  .works-rail:focus-visible {
    outline: 3px solid #000;
    outline-offset: 4px;
  }
</style>

<script>
  const rail = document.querySelector(".works-rail")!;
  const prev = document.getElementById("rail-prev") as HTMLButtonElement;
  const next = document.getElementById("rail-next") as HTMLButtonElement;
  const step = () =>
    window.matchMedia("(prefers-reduced-motion: reduce)").matches
      ? "auto"
      : "smooth";

  // Scroll one "page" = one card + gap, so the last card lands flush-left.
  const pageStep = () => {
    const card = rail.querySelector<HTMLElement>("article");
    if (!card) return 340;
    const gap = parseFloat(getComputedStyle(rail).columnGap) || 24;
    return card.offsetWidth + gap;
  };

  prev.addEventListener("click", () =>
    rail.scrollBy({ left: -pageStep(), behavior: step() }),
  );
  next.addEventListener("click", () =>
    rail.scrollBy({ left: pageStep(), behavior: step() }),
  );

  // Reflect scroll position: disable the arrows that have nowhere to go, and
  // fade only the edge that still has hidden cards behind it.
  const fadeStart = document.querySelector<HTMLElement>('[data-rail-fade="start"]');
  const fadeEnd = document.querySelector<HTMLElement>('[data-rail-fade="end"]');

  const syncRail = () => {
    const max = rail.scrollWidth - rail.clientWidth;
    const atStart = rail.scrollLeft <= 1;
    const atEnd = rail.scrollLeft >= max - 1;
    prev.disabled = atStart;
    next.disabled = atEnd;
    fadeStart?.toggleAttribute("data-active", !atStart);
    fadeEnd?.toggleAttribute("data-active", !atEnd);
  };

  rail.addEventListener("scroll", syncRail, { passive: true });
  // Card widths are breakpoint-dependent, so re-measure on resize too.
  window.addEventListener("resize", syncRail, { passive: true });
  syncRail();

  // Live GitHub stars — client-only, cached 6h to respect rate limits.
  // Falls back to static text if offline / rate-limited (privacy: no trackers, direct GitHub API call).
  (async () => {
    const nodes = Array.from(
      document.querySelectorAll("[data-gh-stars]"),
    ) as HTMLElement[];
    if (!nodes.length) return;

    const CACHE_KEY = "gh-stars-cache-v1";
    const TTL = 6 * 60 * 60 * 1000;
    type Cache = Record<string, { stars: number; forks: number; at: number }>;
    let cache: Cache = {};
    try {
      cache = JSON.parse(localStorage.getItem(CACHE_KEY) ?? "{}");
    } catch {
      cache = {};
    }

    const fmt = (n: number) =>
      new Intl.NumberFormat("en", { notation: "compact" }).format(n);

    const paint = (repo: string, stars: number, live: boolean) => {
      nodes
        .filter((el) => el.dataset.ghStars === repo)
        .forEach((el) => {
          el.textContent = `★ ${fmt(stars)} on GitHub`;
          el.setAttribute("title", live ? `Live from GitHub · ${repo}` : `Cached · ${repo}`);
        });
    };

    const repos = [...new Set(nodes.map((el) => el.dataset.ghStars!))];
    const now = Date.now();
    const toFetch = repos.filter(
      (r) => !cache[r] || now - cache[r]!.at > TTL,
    );

    // Paint cache immediately so something live-ish shows instantly
    repos.forEach((r) => {
      if (cache[r]) paint(r, cache[r]!.stars, false);
    });

    await Promise.allSettled(
      toFetch.map(async (repo) => {
        const res = await fetch(`https://api.github.com/repos/${repo}`);
        if (!res.ok) throw new Error(`GitHub ${res.status}`);
        const data = await res.json();
        if (typeof data.stargazers_count !== "number") throw new Error("bad payload");
        cache[repo] = {
          stars: data.stargazers_count,
          forks: data.forks_count ?? 0,
          at: Date.now(),
        };
        paint(repo, data.stargazers_count, true);
      }),
    );

    try {
      localStorage.setItem(CACHE_KEY, JSON.stringify(cache));
    } catch {
      /* storage full / private mode — ignore */
    }
  })();
</script>
