    role: "Creator",
    outcome: "Delta Merkle Sync · Zero-Dep",
    repo: "pritkr/pebble-sync",
    fallbackStars: 58,
    cover: "/assets/beuconnect-preview.png",
    link: "https://github.com/pritkr/pebble-sync",
    externalLabel: "Repository",
    caseStudy: "/projects/pebble-sync",
    meta: "TypeScript · Distributed Systems",
  },
  {
    name: "spec-forge",
    desc: `Autonomous agentic code verification and AST-preserving mutation testing engine. Hunts regressions in LLM-generated code by synthesizing invariant tests.`,
    role: "Creator",
    outcome: "AST Mutator & Test Synthesis",
    repo: "pritkr/spec-forge",
    fallbackStars: 49,
    cover: "/assets/predirectpreview.avif",
    link: "https://github.com/pritkr/spec-forge",
    externalLabel: "Repository",
    caseStudy: "/projects/spec-forge",
    meta: "Python · AST · Agentic AI",
  },
  {
    name: "Predirect",
    desc: `One install kills the tracking — 30+ tracked sites (YouTube, X, Reddit, Google…) rewritten to privacy-friendly frontends.`,
    role: "Solo developer",
    outcome: "Chrome, Firefox, Edge",
    repo: "pritkr/predirect",
    fallbackStars: 270,
    cover: "/assets/predirectpreview.avif",
    link: "https://github.com/pritkr/predirect",
    externalLabel: "Repository",
    caseStudy: "/projects/predirect",
    meta: "Manifest V3 · JavaScript",
  },
  {
    name: "BEU Connect",
    desc: `No more treasure hunts across official portals — syllabus, results & notices for every BEU college in one static page that works on any phone.`,
    role: "Solo developer",
    outcome: "Zero-backend static portal",
    cover: "/assets/beuconnect-preview.png",
    link: "https://beu.prit.eu.org",
    externalLabel: "Live demo",
    meta: "HTML · CSS · JS",
  },
  {
    name: "chaind",
