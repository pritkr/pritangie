---

<section class="py-25 space-y-10 px-5" id="work">
  <div class="max-w-md mx-auto relative">
    <h1 class="text-4xl font-medium text-center">My Works</h1>
    <img
      src={svgUnderline.src}
      alt="arrow"
      width="140"
      class="absolute left-50 -bottom-1"
    />
  </div>

  <div class="max-w-4xl mx-auto relative">
    <button
      id="rail-prev"
      aria-label="Previous projects"
      class="hidden md:flex absolute -left-4 top-1/2 -translate-y-1/2 z-10 size-11 items-center justify-center bg-white border-3 border-black text-xl font-bold shadow-[3px_3px_0_#000]"
    >
      ←
    </button>
    <div class="works-rail flex gap-6 overflow-x-auto snap-x snap-mandatory px-1 py-4">
      {
        portfolio.map((item) => (
          <article
            class="group w-[300px] sm:w-[340px] shrink-0 snap-start flex flex-col bg-white border-2 border-black p-5 relative transition-all duration-200 hover:shadow-[4px_4px_0px_rgba(0,0,0,0.3)]"
          >
            <div class="h-[160px] overflow-hidden bg-[#eef0f2] border-2">
              <img
                src={item.cover}
                alt={`${item.name} screenshot`}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
            </div>
            <div class="flex flex-col gap-1 pt-4 flex-1">
              <div class="flex pr-2">
                <h2 class="text-xl font-medium flex-1">{item.name}</h2>
                <img src={arrowCard.src} alt="arrow" width="25" />
              </div>
              <p class="text-sm">{item.desc}</p>
              {item.role && (
                <p class="text-sm">
                  <span class="font-semibold">{item.role}</span> · {item.outcome}
                </p>
              )}
              {(item as { repo?: string; fallbackStars?: number }).repo && (
                <p class="mt-1 inline-flex w-fit items-center gap-2 border-2 border-black bg-[#fefff0] px-2 py-0.5 text-xs font-bold">
                  <span class="relative flex size-2">
                    <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-green-500 opacity-75"></span>
                    <span class="relative inline-flex size-2 rounded-full bg-green-600"></span>
                  </span>
                  <span
                    data-gh-stars={(item as { repo: string }).repo}
                    data-fallback={
                      (item as { fallbackStars?: number }).fallbackStars
                        ? `★ ${(item as { fallbackStars: number }).fallbackStars}`
                        : "★ —"
                    }
                  >
                    {(item as { fallbackStars?: number }).fallbackStars
                      ? `★ ${(item as { fallbackStars: number }).fallbackStars} on GitHub`
                      : "★ live on GitHub"}
                  </span>
                  <span class="font-normal text-gray-500" data-gh-updated style="display:none"></span>
                </p>
              )}
              {item.meta && (
                <span class="self-start mt-1 px-3 py-1 text-xs font-semibold bg-[var(--yellow)] border-2 border-black">
                  {item.meta}
                </span>
              )}
              <div class="flex flex-wrap gap-x-5 gap-y-1 pt-2 text-sm font-semibold">
                {item.caseStudy && (
                  <a
                    href={item.caseStudy}
                    class="underline decoration-2 underline-offset-2 hover:bg-[var(--yellow)] px-0.5 transition-colors"
                  >
                    Case study →
                  </a>
                )}
                <a
                  href={item.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="underline decoration-2 underline-offset-2 hover:bg-[var(--yellow)] px-0.5 transition-colors"
                >
                  {item.externalLabel} ↗
                </a>
              </div>
            </div>
            <Bars />
          </article>
        ))
      }
    </div>
    <button
      id="rail-next"
      aria-label="Next projects"
      class="hidden md:flex absolute -right-4 top-1/2 -translate-y-1/2 z-10 size-11 items-center justify-center bg-white border-3 border-black text-xl font-bold shadow-[3px_3px_0_#000]"
    >
      →
    </button>
  </div>
</section>

<style>
  .works-rail {
    scrollbar-width: none;
  }
  .works-rail::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  const rail = document.querySelector(".works-rail")!;
  const step = () =>
    window.matchMedia("(prefers-reduced-motion: reduce)").matches
      ? "auto"
      : "smooth";

  document.getElementById("rail-prev")!.addEventListener("click", () =>
    rail.scrollBy({ left: -360, behavior: step() }),
  );
  document.getElementById("rail-next")!.addEventListener("click", () =>
    rail.scrollBy({ left: 360, behavior: step() }),
  );

  // Live GitHub stars — client-only, cached 6h to respect rate limits.
  // Falls back to static text if offline / rate-limited (privacy: no trackers, direct GitHub API call).
  (async () => {
    const nodes = Array.from(
      document.querySelectorAll("[data-gh-stars]"),
    ) as HTMLElement[];
    if (!nodes.length) return;

    const CACHE_KEY = "gh-stars-cache-v1";
    const TTL = 6 * 60 * 60 * 1000;
    type Cache = Record<string, { stars: number; forks: number; at: number }>;
    let cache: Cache = {};
    try {
      cache = JSON.parse(localStorage.getItem(CACHE_KEY) ?? "{}");
    } catch {
      cache = {};
    }

    const fmt = (n: number) =>
      new Intl.NumberFormat("en", { notation: "compact" }).format(n);

    const paint = (repo: string, stars: number, live: boolean) => {
      nodes
        .filter((el) => el.dataset.ghStars === repo)
        .forEach((el) => {
          el.textContent = `★ ${fmt(stars)} on GitHub${live ? "" : ""}`;
          el.setAttribute("title", live ? `Live from GitHub · ${repo}` : `Cached · ${repo}`);
        });
    };

    const repos = [...new Set(nodes.map((el) => el.dataset.ghStars!))];
    const now = Date.now();
    const toFetch = repos.filter(
      (r) => !cache[r] || now - cache[r]!.at > TTL,
    );

    // Paint cache immediately so something live-ish shows instantly
    repos.forEach((r) => {
      if (cache[r]) paint(r, cache[r]!.stars, false);
    });

    await Promise.allSettled(
      toFetch.map(async (repo) => {
        const res = await fetch(`https://api.github.com/repos/${repo}`);
        if (!res.ok) throw new Error(`GitHub ${res.status}`);
        const data = await res.json();
        if (typeof data.stargazers_count !== "number") throw new Error("bad payload");
        cache[repo] = {
          stars: data.stargazers_count,
          forks: data.forks_count ?? 0,
          at: Date.now(),
        };
        paint(repo, data.stargazers_count, true);
      }),
    );

    try {
      localStorage.setItem(CACHE_KEY, JSON.stringify(cache));
    } catch {
      /* storage full / private mode — ignore */
    }
  })();
</script>
