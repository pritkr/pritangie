---
interface Props {
	title?: string;
	description?: string;
	image?: string;
}

import ScrollProgress from "../components/ScrollProgress.astro";
import BackToTop from "../components/BackToTop.astro";
import CommandPalette from "../components/CommandPalette.astro";
import Reveal from "../components/Reveal.astro";

const {
	title = "Prit's Den — Open Source & Privacy Tech",
	description = "Prit Kumar — privacy-first open-source developer and FOSS educator. Maintainer of Predirect (270+ ★), co-founder of Bodhya FOSS community.",
	image = "/assets/predirectpreview.avif"
} = Astro.props;

const site = Astro.site ?? new URL("https://prit.eu.org");
const canonicalURL = new URL(Astro.url.pathname, site);
const socialImageURL = new URL(image, site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>

		<!-- Primary Meta Tags -->
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<meta name="author" content="Prit Kumar" />
		<link rel="canonical" href={canonicalURL} />

		<!-- Open Graph / Facebook / LinkedIn / Matrix -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={socialImageURL} />
		<meta property="og:site_name" content="Prit's Den" />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonicalURL} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={socialImageURL} />

		<!-- Icons & Manifest -->
		<link
			rel="icon"
			type="image/png"
			sizes="192x192"
			href="/favicon-192x192.png"
		/>
		<link
			rel="apple-touch-icon"
			sizes="180x180"
			href="/apple-touch-icon.png"
		/>
		<link
			rel="icon"
			type="image/png"
			sizes="32x32"
			href="/favicon-32x32.png"
		/>
		<meta name="theme-color" content="#fefff0" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />
		<link rel="stylesheet" href="/fonts/remixicon/remixicon.css" />

		{/*
		  View transition — a push, not a wipe.

		  This used to be `::view-transition-old(root) { animation: none }` plus a
		  200ms clip-path wipe on the new page, which left the outgoing page
		  sitting there as a frozen, fully-opaque photograph while a sheet slid
		  over it: a slide deck, not navigation. Now both pages move — the old
		  one accelerates out underneath while the new one eases in over it — and
		  the header is pulled out of the root snapshot so the nav bar holds still
		  and only page content appears to move.

		  Direction-aware reversal was tried and dropped: Chrome does not fire a
		  `navigate` event for browser-initiated traversals, so back/forward
		  could not be detected reliably. This push is always forward.

		  Kept inline (is:inline) rather than in the component <style> because
		  Astro extracts that to an external stylesheet, and a transition whose
		  rules have not loaded yet falls back to the UA crossfade.
		*/}
		<style is:inline>
			@view-transition {
				navigation: auto;
			}
			::view-transition-old(root) {
				animation: vt-out 200ms cubic-bezier(0.4, 0, 1, 1) both;
			}
			::view-transition-new(root) {
				animation: vt-in 340ms cubic-bezier(0.22, 1, 0.36, 1) both;
			}
			/* The old page drifts back and fades — it is leaving, not covered. */
			@keyframes vt-out {
				to {
					transform: translateX(-2.5%);
					opacity: 0;
				}
			}
			/* The new page arrives from the right on a strong ease-out: fast off
			   the line, soft landing. Longer than the exit so the two overlap and
			   read as one gesture rather than two queued steps. */
			@keyframes vt-in {
				from {
					transform: translateX(100%);
				}
			}
			/* The header is a persistent landmark, not page content. */
			::view-transition-group(site-header) {
				animation: none;
			}
			::view-transition-old(site-header),
			::view-transition-new(site-header) {
				animation: none;
			}
			@media (prefers-reduced-motion: reduce) {
				::view-transition-group(*),
				::view-transition-old(*),
				::view-transition-new(*) {
					animation: none !important;
				}
			}
		</style>
		<link rel="alternate" type="application/rss+xml" title="Prit's Den" href={new URL("/rss.xml", site).href} />
	</head>
	<body>
		<ScrollProgress />
		<Reveal />
		<slot />
		<CommandPalette />
		<BackToTop />
	</body>
</html>

<style>
	:root {
		--main-bg: #fefff0;
		--blue: #bae6ff;
		--yellow: #ffdc58;
	}

	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		background-color: var(--main-bg);
		font-family: "Space Grotesk", sans-serif;
		scroll-behavior: smooth;
	}
</style>
<script is:inline>
	if ("serviceWorker" in navigator) {
		navigator.serviceWorker
			.register("/sw.js")
			.then((reg) => {
				console.log("Service worker registered: " + reg.scope);
			})
			.catch((error) => {
				console.log("Registration failed with " + error);
			});
	}
</script>