---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import svgUnderline from "../assets/underline.svg";
import { author } from "../sample";
import { galleryPosts } from "../data/gallery";

/*
  A self-hosted photo wall.

  Justified rows rather than a uniform grid: every image keeps its true aspect
  ratio, and each row is only as tall as it needs to be, so the wall has no
  dead space and nothing is cropped. Row membership is computed here at build
  time from the original pixel dimensions, and each image's width comes from a
  flex-grow factor equal to its aspect ratio — so a row scales with the
  container and every image keeps its shape at any width. No JavaScript, no
  layout shift, and the reading order stays newest-first.

  The wall uses the small `cover` files (~43KB each, fetched lazily as you
  scroll); the `full` size is fetched only when the viewer opens.
*/

/*
  Rows are not all the same height. A single target ratio makes a technically
  correct wall that reads as a spreadsheet — every band the same depth, the eye
  has nothing to catch on. Cycling a few ratios gives the wall a rhythm: some
  rows sit tall and let a portrait breathe, others run wide and quick. It is
  still fully justified, just with an uneven pulse.

  The ratio is the sum of the aspect ratios in a row, so the row's rendered
  height is containerWidth / ratio. Lower = taller row, fewer photos in it.
*/
const ROW_RHYTHM = [3.0, 3.7, 2.6, 3.3];
const GUTTER = 6; // px, mirrored in the flex gap classes below

type Img = { full: string; cover: string; w: number; h: number; post: number; n: number };

const flat: Img[] = [];
galleryPosts.forEach((post, pi) => {
  post.images.forEach((im, n) => {
    flat.push({
      full: im.full,
      cover: im.cover,
      w: im.w || 4,
      h: im.h || 3,
      post: pi,
      n,
    });
  });
});

// Pack images into justified rows: fill a row until adding the next image
// would exceed that row's aspect budget, then start a new row on the next
// ratio in the rhythm.
const rows: Img[][] = [];
let cur: Img[] = [];
let curW = 0;
for (const im of flat) {
  const budget = ROW_RHYTHM[rows.length % ROW_RHYTHM.length]!;
  const r = im.w / im.h;
  if (cur.length && curW + r > budget) {
    rows.push(cur);
    cur = [];
    curW = 0;
  }
  cur.push(im);
  curW += r;
}
if (cur.length) rows.push(cur);

const totalImages = flat.length;
const totalLikes = galleryPosts.reduce((n, p) => n + p.likes, 0);
const when = new Intl.DateTimeFormat("en", { month: "short", day: "numeric", year: "numeric" });
const handle = author.ig.replace(/\/+$/, "").split("/").pop();
const oldest = galleryPosts[galleryPosts.length - 1]?.date ?? "";
const newest = galleryPosts[0]?.date ?? "";
const span =
  oldest && newest && oldest !== newest
    ? `${when.format(new Date(oldest))} – ${when.format(new Date(newest))}`
    : when.format(new Date(newest));

/* Payload for the viewer: grouped by post, so opening a photo shows that whole
   post rather than a single image. `shotIndex` maps a wall tile to its post. */
const viewerData = galleryPosts.map((post) => ({
  date: post.date,
  likes: post.likes,
  permalink: post.permalink,
  caption: post.caption,
  videoCount: post.videoCount,
  images: post.images.map((im) => ({ full: im.full, w: im.w, h: im.h })),
}));
const shotIndex = flat.map((im) => im.post);
---

<Layout
  title="Gallery — Prit Kumar"
  description={`${totalImages} photos from ${galleryPosts.length} posts by @${handle} on Instagram, self-hosted — hackathons, college events, travel and everything in between.`}
>
  <Header />

  <section class="pt-12 pb-8 sm:pt-16">
    <div class="max-w-6xl mx-auto px-4">
      <div class="relative inline-block">
        <h1 class="text-5xl font-black">Gallery</h1>
        <img
          src={svgUnderline.src}
          alt=""
          width="200"
          class="absolute -bottom-3 left-0"
        />
      </div>

      <div class="mt-10 flex flex-wrap items-end gap-x-10 gap-y-6">
        <p class="max-w-md text-lg leading-relaxed">
          Every photo from{" "}
          <a
            href={author.ig}
            target="_blank"
            rel="noopener noreferrer"
            class="underline decoration-2 underline-offset-2 transition-colors duration-150 hover:bg-[var(--yellow)]"
            >@{handle}</a
          >, served from this site rather than embedded from Instagram. Click
          any photo and the whole post it came from opens.
        </p>

        <dl class="flex gap-2">
          {
            [
              { n: totalImages, label: "photos" },
              { n: galleryPosts.length, label: "posts" },
              { n: totalLikes, label: "likes" },
            ].map((s) => (
              <div class="border-3 border-black bg-white px-3 py-2 transition-shadow duration-200 hover:shadow-[4px_4px_0_#000]">
                <dt class="font-mono text-[10px] uppercase tracking-wider text-black/55">
                  {s.label}
                </dt>
                <dd class="mt-0.5 text-2xl leading-none font-black tabular-nums">
                  {s.n.toLocaleString("en")}
                </dd>
              </div>
            ))
          }
          <div class="border-3 border-dashed border-black/35 px-3 py-2">
            <dt class="font-mono text-[10px] uppercase tracking-wider text-black/55">
              span
            </dt>
            <dd class="mt-0.5 text-2xl leading-none font-black tabular-nums">
              {new Date(newest).getFullYear()}
            </dd>
          </div>
        </dl>
      </div>
      <p class="mt-4 font-mono text-sm text-black/60">{span}</p>
    </div>
  </section>

  <section class="pb-20">
    <div class="max-w-6xl mx-auto px-4">
      <div data-wall class="flex flex-col gap-1.5">
        {
          rows.map((row) => (
            <div class="flex gap-1.5">
              {row.map((im) => {
                const post = galleryPosts[im.post]!;
                return (
                  <button
                    type="button"
                    data-shot={im.post}
                    data-n={im.n}
                    class="group relative block overflow-hidden bg-[#e8e4d8] outline-3 outline-transparent transition-shadow duration-200 hover:z-10 hover:shadow-[5px_5px_0_#000] hover:outline-black focus-visible:z-10 focus-visible:shadow-[5px_5px_0_#000] focus-visible:outline-black"
                    style={`flex: ${(im.w / im.h).toFixed(4)} 1 0%`}
                    aria-label={`Open post ${im.post + 1}, photo ${im.n + 1}: ${post.caption ?? ""}`}
                  >
                    <img
                      src={im.cover}
                      alt={post.caption ?? "Photo"}
                      width={im.w}
                      height={im.h}
                      loading="lazy"
                      decoding="async"
                      class="h-full w-full object-cover transition-transform duration-500 ease-[var(--ease-out)] group-hover:scale-[1.04]"
                    />

                    {/* Metadata stays out of the way until hover or keyboard
                        focus. `hover:` in Tailwind v4 only fires on
                        hover-capable pointers, so touch is unaffected. */}
                    <span
                      aria-hidden="true"
                      class="pointer-events-none absolute inset-x-0 bottom-0 flex items-end justify-between gap-2 bg-linear-to-t from-black/75 via-black/15 to-transparent p-2 opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-focus-visible:opacity-100"
                    >
                      <span class="font-mono text-[10px] leading-tight text-white">
                        {when.format(new Date(post.date))}
                      </span>
                      {post.videoCount > 0 && (
                        <span class="shrink-0 border border-white/70 px-1 py-px font-mono text-[9px] uppercase tracking-wider text-white">
                          reel
                        </span>
                      )}
                    </span>
                  </button>
                );
              })}
            </div>
          ))
        }
      </div>

      <p class="mt-10 text-sm text-black/60">
        Shot on whatever was in the pocket that day. Anything missing lives on{" "}
        <a
          href={author.ig}
          target="_blank"
          rel="noopener noreferrer"
          class="underline decoration-2 underline-offset-2 transition-colors duration-150 hover:bg-[var(--yellow)]"
          >Instagram</a
        >.
      </p>
    </div>
  </section>

  {/*
    The viewer script runs in the browser, where Astro's frontmatter scope does
    not exist — so the data is serialised here and read back from the DOM. `<`
    is escaped so a caption can never close the script tag early.
  */}
  <script
    type="application/json"
    data-viewer-data
    is:inline
    set:html={JSON.stringify(viewerData).replace(/</g, "\\u003c")}
  />

  <div
    data-viewer
    hidden
    class="fixed inset-0 z-[80] flex flex-col bg-black/95 backdrop-blur-md"
    role="dialog"
    aria-modal="true"
    aria-label="Photo viewer"
  >
    <header class="flex shrink-0 items-center justify-between gap-4 px-4 py-3 sm:px-6">
      <p data-v-meta class="font-mono text-xs text-white/60"></p>
      <button
        type="button"
        data-v-close
        class="grid size-10 shrink-0 place-items-center border border-white/70 text-xl leading-none text-white transition-transform duration-150 hover:rotate-90 active:scale-95"
        aria-label="Close photo viewer"
      >
        ×
      </button>
    </header>

    <div class="relative flex min-h-0 flex-1 items-center justify-center px-12 sm:px-20">
      <button
        type="button"
        data-v-prev
        class="absolute left-2 z-10 grid size-11 place-items-center rounded-full border border-white/40 text-white transition-colors duration-150 hover:bg-white/10 active:scale-95 sm:left-4"
        aria-label="Previous photo"
      >
        ←
      </button>
      <img
        data-v-img
        src="data:image/gif;base64,R0lGODlhAQABAIAAAP///wAAACH5BAEAAAAALAAAAAABAAEAAAICRAEAOw=="
        alt=""
        class="max-h-full max-w-full object-contain"
      />
      <button
        type="button"
        data-v-next
        class="absolute right-2 z-10 grid size-11 place-items-center rounded-full border border-white/40 text-white transition-colors duration-150 hover:bg-white/10 active:scale-95 sm:right-4"
        aria-label="Next photo"
      >
        →
      </button>
    </div>

    <footer class="shrink-0 px-4 pb-5 pt-3 sm:px-6">
      <div class="mx-auto max-w-3xl">
        <p data-v-caption class="text-sm leading-relaxed text-white/90"></p>
        <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-white/55">
          <span data-v-dots class="font-mono"></span>
          <a
            data-v-link
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="underline decoration-2 underline-offset-2 transition-colors duration-150 hover:text-white"
          >
            View post on Instagram
          </a>
          <span class="ml-auto flex items-center gap-2">
            <button
              type="button"
              data-v-post-prev
              class="border border-white/40 px-2.5 py-1 transition-colors duration-150 hover:bg-white/10 disabled:opacity-30"
            >
              ← Prev post
            </button>
            <button
              type="button"
              data-v-post-next
              class="border border-white/40 px-2.5 py-1 transition-colors duration-150 hover:bg-white/10 disabled:opacity-30"
            >
              Next post →
            </button>
          </span>
        </div>
        <div data-v-strip class="mt-3 flex flex-wrap gap-1.5" role="group" aria-label="Photos in this post"></div>
      </div>
    </footer>
  </div>
</Layout>

<style is:global>
  /* The clicked tile grows into the viewer's letterboxed photo and shrinks back
     on close. Timing matches the site's --ease-out so the morph feels like the
     rest of the motion, not a separate effect bolted on. */
  ::view-transition-group(gallery-photo) {
    animation-duration: 320ms;
    animation-timing-function: cubic-bezier(0.23, 1, 0.32, 1);
  }
  /* Everything else — the wall behind, the viewer chrome — just cross-fades
     rather than sliding, so the photo is the only thing that appears to move. */
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation-duration: 200ms;
  }
</style>

<script>
  type Img = { full: string; w: number; h: number };
  type Post = {
    date: string;
    likes: number;
    permalink: string;
    caption: string;
    videoCount: number;
    images: Img[];
  };

  // Frontmatter scope does not exist in the browser — read the data back.
  const data = document.querySelector<HTMLScriptElement>("[data-viewer-data]")!;
  const posts: Post[] = JSON.parse(data.textContent!);
  const when = new Intl.DateTimeFormat("en", { month: "short", day: "numeric", year: "numeric" });

  const viewer = document.querySelector<HTMLElement>("[data-viewer]")!;
  const img = document.querySelector<HTMLImageElement>("[data-v-img]")!;
  const meta = document.querySelector<HTMLElement>("[data-v-meta]")!;
  const cap = document.querySelector<HTMLElement>("[data-v-caption]")!;
  const dots = document.querySelector<HTMLElement>("[data-v-dots]")!;
  const link = document.querySelector<HTMLAnchorElement>("[data-v-link]")!;
  const strip = document.querySelector<HTMLElement>("[data-v-strip]")!;
  const prevBtn = document.querySelector<HTMLButtonElement>("[data-v-prev]")!;
  const nextBtn = document.querySelector<HTMLButtonElement>("[data-v-next]")!;
  const postPrev = document.querySelector<HTMLButtonElement>("[data-v-post-prev]")!;
  const postNext = document.querySelector<HTMLButtonElement>("[data-v-post-next]")!;
  const closeBtn = document.querySelector<HTMLButtonElement>("[data-v-close]")!;
  const tiles = document.querySelectorAll<HTMLButtonElement>("[data-shot]");

  let p = 0; // post index
  let i = 0; // image index within the post
  let builtFor = -1;
  /** The wall tile the viewer was opened from, so focus can go back to it. */
  let openedFrom: HTMLButtonElement | undefined;

  /* The strip is rebuilt only when the post changes — not on every arrow press,
     and never 88 nodes up front. */
  function buildStrip() {
    if (builtFor === p) return;
    builtFor = p;
    strip.textContent = "";
    posts[p]!.images.forEach((_, n) => {
      const b = document.createElement("button");
      b.type = "button";
      b.className = "size-8 border transition-colors duration-150";
      b.setAttribute("aria-label", `Photo ${n + 1} of ${posts[p]!.images.length}`);
      b.addEventListener("click", () => show(n));
      strip.append(b);
    });
  }

  function paintStrip() {
    [...strip.children].forEach((c, n) => {
      c.className =
        "size-8 border transition-colors duration-150 " +
        (n === i ? "border-white bg-white" : "border-white/35 hover:border-white/80");
    });
  }

  /* Images navigate within the post; the explicit Prev/Next post buttons move
     between posts, so browsing never silently jumps to a different caption. */
  function show(n: number) {
    const post = posts[p]!;
    i = (n + post.images.length) % post.images.length;
    const image = post.images[i]!;
    img.src = image.full;
    img.alt = post.caption || "Photo";
    // Reserve the true aspect ratio so nothing reflows as the image decodes.
    img.style.aspectRatio = image.w && image.h ? `${image.w} / ${image.h}` : "";
    meta.textContent =
      `${when.format(new Date(post.date))} · ${post.likes.toLocaleString("en")} likes` +
      (post.videoCount ? ` · ${post.videoCount} video${post.videoCount > 1 ? "s" : ""}` : "");
    cap.textContent = post.caption || "";
    link.href = post.permalink;
    dots.textContent = `post ${p + 1} / ${posts.length} · photo ${i + 1} of ${post.images.length}`;
    prevBtn.disabled = nextBtn.disabled = post.images.length < 2;
    postPrev.disabled = p === 0;
    postNext.disabled = p === posts.length - 1;
    buildStrip();
    paintStrip();
  }

  /* The photo grows out of the tile it was clicked from and shrinks back into
     it on close, using the native View Transitions API — no library.

     The name is a single baton that must be held by exactly one element at a
     time: two elements sharing it aborts the whole transition. So it is passed
     from the tile to the viewer image on open, and back on close — never
     duplicated. Naming all 88 tiles up front would abort every time. */
  const NAME = "gallery-photo";
  const calm = matchMedia("(prefers-reduced-motion: reduce)");
  const canMorph = () => document.startViewTransition && !calm.matches;

  function openPost(postIndex: number, imageIndex = 0, from?: HTMLButtonElement) {
    p = Math.max(0, Math.min(posts.length - 1, postIndex));
    if (from) openedFrom = from;

    const apply = () => {
      show(imageIndex);
      viewer.hidden = false;
      document.body.style.overflow = "hidden";
      closeBtn.focus();
    };
    if (!canMorph() || !from) return apply();

    from.style.viewTransitionName = NAME;
    try {
      document.startViewTransition(() => {
        from.style.viewTransitionName = "";
        // The image keeps the name while the viewer is open, so closing can
        // morph back out of it.
        img.style.viewTransitionName = NAME;
        apply();
      });
    } catch {
      // An aborted transition is cosmetic; the viewer still has to open.
      from.style.viewTransitionName = "";
      apply();
    }
  }

  function close() {
    const fallback = Number(openedFrom?.dataset.shot ?? p);
    const target = openedFrom ?? tiles[fallback];

    const apply = () => {
      viewer.hidden = true;
      img.removeAttribute("src");
      document.body.style.overflow = "";
      target?.focus();
    };
    // Back to the tile that was actually clicked. Post navigation can leave the
    // viewer on a different post, so the opener — not the current post — is what
    // focus should return to. Falls back to the first tile of the current post.
    openedFrom = undefined;

    if (!canMorph() || !target) return apply();
    const run = document.startViewTransition(() => {
      img.style.viewTransitionName = "";
      target.style.viewTransitionName = NAME;
      apply();
    });
    // Release the tile's name once the morph lands, or the next open — on a
    // different tile — would be a duplicate. `finished` rejects when a
    // transition is skipped, which must not surface as an unhandled error.
    run.finished
      .catch(() => {})
      .finally(() => {
        target.style.viewTransitionName = "";
      });
  }

  tiles.forEach((t) => {
    const shot = Number(t.dataset.shot);
    t.addEventListener("click", () => {
      // A wall tile knows which post it belongs to; open that post on the image
      // it represents so the two agree.
      const imgIndex = t.dataset.n ? Number(t.dataset.n) : 0;
      openPost(shot, imgIndex, t);
    });
  });
  prevBtn.addEventListener("click", () => show(i - 1));
  nextBtn.addEventListener("click", () => show(i + 1));
  // Moving between posts does not change the opener — Esc should still land back
  // on the photo the viewer was opened from.
  postPrev.addEventListener("click", () => openPost(p - 1, 0));
  postNext.addEventListener("click", () => openPost(p + 1, 0));
  closeBtn.addEventListener("click", close);
  viewer.addEventListener("click", (e) => {
    if (e.target === viewer) close();
  });

  document.addEventListener("keydown", (e) => {
    if (viewer.hidden) return;
    if (e.key === "Escape") return close();
    if (e.key === "ArrowLeft") { e.preventDefault(); show(i - 1); }
    if (e.key === "ArrowRight") { e.preventDefault(); show(i + 1); }
    if (e.key === "Tab") {
      const ring = [closeBtn, prevBtn, nextBtn, postPrev, postNext, ...strip.children].filter(
        (b) => !(b as HTMLButtonElement).disabled,
      ) as HTMLElement[];
      const at = ring.indexOf(document.activeElement as HTMLElement);
      if (at < 0) return;
      e.preventDefault();
      ring[(at + (e.shiftKey ? -1 : 1) + ring.length) % ring.length]?.focus();
    }
  });
</script>
